# 🦞 Lobster AI Configuration

# Core Settings
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=30000

# Alternative: LM Studio
# LLM_PROVIDER=lmstudio
# LMSTUDIO_URL=http://localhost:1234

# Voice Configuration
VOICE_ENABLED=true
WHISPER_MODEL=base
TTS_PROVIDER=local

# Database
DB_PATH=./data/lobster.db

# Chat Platforms - Leave blank to disable

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_ENABLED=false

# Discord
DISCORD_TOKEN=
DISCORD_ENABLED=false

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ENABLED=false

# WhatsApp (Web.js - runs locally)
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_PATH=./data/whatsapp-session

# Privacy & Security
ENABLE_ANALYTICS=false
ENABLE_TELEMETRY=false
ALLOW_REMOTE_ACCESS=false
MAX_MESSAGE_HISTORY=1000

# Personality
PERSONALITY_NAME=Lobster
PERSONALITY_QUIRKY_MODE=true